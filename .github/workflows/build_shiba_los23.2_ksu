name: Build LineageOS 23.2 Shiba Kernel (KernelSU)

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-22.04
    steps:
      - name: Free Disk Space
        run: |
          sudo rm -rf /usr/share/dotnet /usr/local/lib/android /opt/ghc
          sudo apt-get clean

      - name: Install Dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y git-core gnupg flex bison build-essential zip curl zlib1g-dev libc6-dev-i386 libncurses5 x11proto-core-dev libx11-dev lib32z1-dev libgl1-mesa-dev libxml2-utils xsltproc unzip fontconfig
          sudo curl -s https://storage.googleapis.com/git-repo-downloads/repo -o /usr/local/bin/repo
          sudo chmod a+x /usr/local/bin/repo

      - name: Sync LineageOS Kernel Source
        run: |
          mkdir kernel_workspace && cd kernel_workspace
          git config --global user.name "Kernel Builder"
          git config --global user.email "bot@example.com"
          repo init -u https://github.com/LineageOS/android_kernel_google_gs-6.1_manifest.git -b lineage-23.2 --depth=1
          repo sync -c -j$(nproc) --no-clone-bundle --no-tags --fail-fast

      - name: Inject KernelSU
        run: |
          set -e 
          mkdir -p $GITHUB_WORKSPACE/diagnostic_logs
          
          cd kernel_workspace/aosp
          # Run the official mainline KernelSU setup script for GKI integration
          curl -LSs "https://raw.githubusercontent.com/tiann/KernelSU/main/kernel/setup.sh" | bash - 2>&1 | tee $GITHUB_WORKSPACE/diagnostic_logs/ksu_setup.log

      - name: Configure and Build (Production)
        run: |
          set -e
          cd kernel_workspace/aosp
          
          CONFIG_FILE="arch/arm64/configs/gki_defconfig"
          
          # Enable KernelSU and the mandatory kprobe hooks for GKI kernels
          cat <<EOF >> $CONFIG_FILE
          CONFIG_KPROBES=y
          CONFIG_KPROBE_EVENTS=y
          CONFIG_KSU=y
          EOF
          
          cd ..
          # Full production build (LTO and BTF enabled)
          tools/bazel run --config=shusky --verbose_failures //private/devices/google/shusky:zuma_shusky_dist 2>&1 | tee $GITHUB_WORKSPACE/diagnostic_logs/bazel_build.log

      - name: Stage Flashable Images
        run: |
          mkdir -p $GITHUB_WORKSPACE/flashable_images
          DIST_DIR="kernel_workspace/out/shusky/dist"
          
          # Isolate the core production images
          cp $DIST_DIR/boot.img $GITHUB_WORKSPACE/flashable_images/ 2>/dev/null || true
          cp $DIST_DIR/init_boot.img $GITHUB_WORKSPACE/flashable_images/ 2>/dev/null || true
          cp $DIST_DIR/vendor_boot.img $GITHUB_WORKSPACE/flashable_images/ 2>/dev/null || true
          cp $DIST_DIR/vendor_kernel_boot.img $GITHUB_WORKSPACE/flashable_images/ 2>/dev/null || true
          cp $DIST_DIR/dtbo.img $GITHUB_WORKSPACE/flashable_images/ 2>/dev/null || true

      - name: Upload Diagnostic Logs
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: Diagnostic-Logs
          path: diagnostic_logs/
          if-no-files-found: warn

      - name: Upload Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: Shiba-Lineage23.2-Images
          path: flashable_images/
          if-no-files-found: error
